---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
  {% for project in site.projects %}
    {% assign publication = site.data.publications.main | where: 'id', project.project_id | first %}
    {% capture excluded %}{% include project-excluded.html publication=publication project=project %}{% endcapture %}
    {% unless excluded == 'true' %}<url><loc>{{ project.url | absolute_url | xml_escape }}</loc></url>{% endunless %}
  {% endfor %}
</urlset>
